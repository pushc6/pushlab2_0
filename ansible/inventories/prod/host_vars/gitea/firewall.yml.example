---
# Host-specific firewall rules for gitea
# These rules are added to terraform_host_firewall_rules automatically

host_specific_rules:
  - name: "HTTP to Gitea from LAN"
    description: "Allow HTTP access to Gitea web UI"
    source: "10.37.0.0/16"
    destination: "gitea"
    protocol: tcp
    port: 80
    interface: lan
    log: true  # Enable logging for this specific rule
    
  - name: "HTTPS to Gitea from LAN"
    description: "Allow HTTPS access to Gitea web UI"
    source: "10.37.0.0/16"
    destination: "gitea"
    protocol: tcp
    port: 443
    interface: lan
    
  - name: "Git SSH to Gitea"
    description: "Allow Git SSH access to Gitea"
    source: "10.37.0.0/16"
    destination: "gitea"
    protocol: tcp
    port: 2222
    interface: lan
