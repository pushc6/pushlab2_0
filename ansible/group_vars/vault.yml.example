---
# Tailscale OAuth credentials
# Copy this file to vault.yml and encrypt with: ansible-vault encrypt vault.yml
#
# Create OAuth client at: https://login.tailscale.com/admin/settings/oauth
# Required settings:
#   - Scopes: auth_keys (write)
#   - Tags: tag:crowdsec-lapi, tag:crowdsec-agent, tag:server-client (all tags you'll use)

tailscale_oauth_client_id: "k..."
tailscale_oauth_client_secret: "tskey-client-..."

# Komodo secrets
# Generate random strings for these: openssl rand -base64 32
vault_komodo_db_password: "changeme"
vault_komodo_passkey: "changeme"
vault_komodo_webhook_secret: "changeme"
vault_komodo_jwt_secret: "changeme"
vault_komodo_admin_password: "changeme"
