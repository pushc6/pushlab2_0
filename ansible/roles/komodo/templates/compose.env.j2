# Komodo Environment Configuration
# Managed by Ansible - do not edit manually

# Image Configuration
COMPOSE_KOMODO_IMAGE_TAG={{ komodo_image_tag }}
COMPOSE_KOMODO_BACKUPS_PATH={{ komodo_backups_path }}

# Database Credentials
KOMODO_DB_USERNAME={{ komodo_db_username }}
KOMODO_DB_PASSWORD={{ komodo_db_password }}

# Security
KOMODO_PASSKEY={{ komodo_passkey }}
TZ={{ komodo_timezone }}

# Komodo Core Settings
KOMODO_HOST={{ komodo_host }}
KOMODO_TITLE={{ komodo_title }}
KOMODO_FIRST_SERVER=https://periphery:8120
KOMODO_FIRST_SERVER_NAME=Local
KOMODO_DISABLE_CONFIRM_DIALOG=false
KOMODO_MONITORING_INTERVAL={{ komodo_monitoring_interval }}
KOMODO_RESOURCE_POLL_INTERVAL={{ komodo_resource_poll_interval }}

# Secrets
KOMODO_WEBHOOK_SECRET={{ komodo_webhook_secret }}
KOMODO_JWT_SECRET={{ komodo_jwt_secret }}
KOMODO_JWT_TTL={{ komodo_jwt_ttl }}

# Authentication
KOMODO_LOCAL_AUTH={{ komodo_local_auth | lower }}
KOMODO_INIT_ADMIN_USERNAME={{ komodo_init_admin_username }}
KOMODO_INIT_ADMIN_PASSWORD={{ komodo_init_admin_password }}
KOMODO_DISABLE_USER_REGISTRATION={{ komodo_disable_user_registration | lower }}
KOMODO_ENABLE_NEW_USERS={{ komodo_enable_new_users | lower }}
KOMODO_DISABLE_NON_ADMIN_CREATE=false
KOMODO_TRANSPARENT_MODE=false

# Logging
KOMODO_LOGGING_PRETTY=false
KOMODO_PRETTY_STARTUP_CONFIG=false

# OAuth Providers
KOMODO_OIDC_ENABLED={{ komodo_oidc_enabled | lower }}
KOMODO_GITHUB_OAUTH_ENABLED={{ komodo_github_oauth_enabled | lower }}
KOMODO_GOOGLE_OAUTH_ENABLED={{ komodo_google_oauth_enabled | lower }}

# AWS Configuration (optional)
KOMODO_AWS_ACCESS_KEY_ID=
KOMODO_AWS_SECRET_ACCESS_KEY=

# Komodo Periphery Settings
PERIPHERY_ROOT_DIRECTORY={{ komodo_periphery_root }}
PERIPHERY_PASSKEYS={{ komodo_passkey }}
PERIPHERY_DISABLE_TERMINALS=false
PERIPHERY_SSL_ENABLED=true
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
PERIPHERY_LOGGING_PRETTY=false
PERIPHERY_PRETTY_STARTUP_CONFIG=false
