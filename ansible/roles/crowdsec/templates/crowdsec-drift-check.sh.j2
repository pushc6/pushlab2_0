#!/usr/bin/env bash
# {{ ansible_managed }}
# CrowdSec bouncer drift detection (cs-firewall-bouncer #243)
#
# The nftables bouncer silently drops IPs from sets when duplicate entries
# are added (timer doesn't refresh). This script detects when LAPI decisions
# drift from what's actually enforced in nftables and injects the missing
# IPs directly. Bouncer restart alone doesn't help — the bouncer re-processes
# the same duplicate decisions and nftables drops them again.
#
# Only checks crowdsec-origin decisions (local detections) since these are
# the ones affected by the timer bug. CAPI/list origins are bulk-loaded
# and less prone to the issue.

set -euo pipefail

TAG="crowdsec-drift-check"
BOUNCER_CONFIG="/etc/crowdsec/bouncers/crowdsec-firewall-bouncer.yaml"
NFT_FAMILY="{{ crowdsec_drift_check_nft_family }}"
NFT_TABLE="{{ crowdsec_drift_check_nft_table }}"
NFT_SET="{{ crowdsec_drift_check_nft_set }}"

{% raw %}
log() { logger -t "$TAG" "$*"; }

# --- Read bouncer config ---
API_URL=$(awk '/^api_url:/{print $2}' "$BOUNCER_CONFIG")
API_KEY=$(awk '/^api_key:/{print $2}' "$BOUNCER_CONFIG")

if [[ -z "$API_URL" || -z "$API_KEY" ]]; then
    log "ERROR: cannot read api_url/api_key from $BOUNCER_CONFIG"
    exit 1
fi

# --- Query LAPI for crowdsec-origin decisions ---
RESPONSE=$(curl -sf --connect-timeout 5 --max-time 10 \
    -H "X-Api-Key: ${API_KEY}" \
    "${API_URL}/v1/decisions?origins=crowdsec" 2>/dev/null) || {
    log "ERROR: LAPI query failed (curl exit $?)"
    exit 1
}

if [[ "$RESPONSE" == "null" || -z "$RESPONSE" ]]; then
    log "OK: no crowdsec-origin decisions in LAPI, nothing to check"
    exit 0
fi

# Extract unique IPs with their max remaining duration from LAPI
# jq groups decisions by IP and picks the longest duration for each
LAPI_DATA=$(echo "$RESPONSE" | jq -r '
    group_by(.value)
    | .[]
    | {ip: .[0].value, duration: (map(.duration) | sort | last)}
    | "\(.ip) \(.duration)"
' 2>/dev/null | sed 's|/32 | |')

if [[ -z "$LAPI_DATA" ]]; then
    log "OK: no crowdsec-origin IPs to verify"
    exit 0
fi

LAPI_COUNT=$(echo "$LAPI_DATA" | wc -l | tr -d ' ')

# --- Snapshot nftables set (single read) ---
NFT_SNAPSHOT=$(nft list set "$NFT_FAMILY" "$NFT_TABLE" "$NFT_SET" 2>/dev/null) || {
    log "WARN: nftables set ${NFT_FAMILY}/${NFT_TABLE}/${NFT_SET} not found"
    exit 0
}

# --- Check each LAPI IP against the snapshot ---
MISSING_COUNT=0
FIXED_COUNT=0
while IFS=' ' read -r ip duration; do
    if ! echo "$NFT_SNAPSHOT" | grep -qwF "$ip"; then
        MISSING_COUNT=$((MISSING_COUNT + 1))
        # Inject directly into nftables — bouncer restart won't help
        # because duplicate decisions trigger the same bug on resync
        if nft add element "$NFT_FAMILY" "$NFT_TABLE" "$NFT_SET" "{ $ip timeout $duration }" 2>/dev/null; then
            log "FIXED: injected $ip (timeout $duration) into nftables"
            FIXED_COUNT=$((FIXED_COUNT + 1))
        else
            log "ERROR: failed to inject $ip into nftables"
        fi
    fi
done <<< "$LAPI_DATA"

if [[ $MISSING_COUNT -eq 0 ]]; then
    log "OK: all $LAPI_COUNT crowdsec-origin IPs present in nftables"
else
    log "DRIFT: $MISSING_COUNT/$LAPI_COUNT IPs were missing, $FIXED_COUNT injected directly"
fi
{% endraw %}
