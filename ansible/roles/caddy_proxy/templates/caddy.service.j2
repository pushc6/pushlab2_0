# {{ ansible_managed }}
[Unit]
Description=Caddy (DMZ reverse proxy + ECH + MQTT layer4)
Documentation=https://caddyserver.com/docs/
After=network.target network-online.target
Requires=network-online.target

[Service]
Type=notify
User={{ caddy_proxy_user }}
Group={{ caddy_proxy_group }}
EnvironmentFile={{ caddy_proxy_config_dir }}/caddy.env
Environment=XDG_DATA_HOME={{ caddy_proxy_data_dir }}
Environment=XDG_CONFIG_HOME={{ caddy_proxy_config_dir }}
ExecStart={{ caddy_proxy_bin_path }} run --config {{ caddy_proxy_config_dir }}/Caddyfile
ExecReload={{ caddy_proxy_bin_path }} reload --config {{ caddy_proxy_config_dir }}/Caddyfile --force
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
ReadWritePaths={{ caddy_proxy_data_dir }} {{ caddy_proxy_log_dir }} {{ caddy_proxy_config_dir }}
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
