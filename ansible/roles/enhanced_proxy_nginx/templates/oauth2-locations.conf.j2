# {{ ansible_managed }}
# OAuth2-Proxy location blocks
# Single OAuth2-proxy instance serving multiple domains

location /oauth2/ {
    proxy_pass http://{{ enhanced_proxy_nginx_oauth2_proxy_host }}:{{ enhanced_proxy_nginx_oauth2_proxy_port }};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Auth-Request-Redirect $scheme://$host$request_uri;
    
    # OAuth2 optimizations
    proxy_connect_timeout {{ enhanced_proxy_nginx_proxy_timeout }};
    proxy_send_timeout {{ enhanced_proxy_nginx_proxy_timeout }};
    proxy_read_timeout {{ enhanced_proxy_nginx_proxy_timeout }};
    proxy_redirect off;
    proxy_buffering off;
    # Header buffers: oauth2-proxy's Set-Cookie on /oauth2/callback carries the
    # session (ID token) and can exceed nginx's default header buffer, which
    # surfaces as "upstream sent too big header" -> 502. Applies even with
    # proxy_buffering off, which only affects the body.
    proxy_buffer_size {{ enhanced_proxy_nginx_oauth2_buffer_size | default('16k') }};
    proxy_buffers {{ enhanced_proxy_nginx_oauth2_buffers | default('8 16k') }};
    proxy_busy_buffers_size {{ enhanced_proxy_nginx_oauth2_busy_buffers_size | default('32k') }};
}

location = /oauth2/auth {
    internal;
    proxy_pass http://{{ enhanced_proxy_nginx_oauth2_proxy_host }}:{{ enhanced_proxy_nginx_oauth2_proxy_port }};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Uri $request_uri;
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header Content-Length "";
    proxy_pass_request_body off;
    
    # Auth-specific timeouts
    proxy_connect_timeout {{ enhanced_proxy_nginx_proxy_timeout }};
    proxy_send_timeout {{ enhanced_proxy_nginx_proxy_timeout }};
    proxy_read_timeout {{ enhanced_proxy_nginx_proxy_timeout }};
    proxy_buffering off;
    # Header buffers: oauth2-proxy's Set-Cookie on /oauth2/callback carries the
    # session (ID token) and can exceed nginx's default header buffer, which
    # surfaces as "upstream sent too big header" -> 502. Applies even with
    # proxy_buffering off, which only affects the body.
    proxy_buffer_size {{ enhanced_proxy_nginx_oauth2_buffer_size | default('16k') }};
    proxy_buffers {{ enhanced_proxy_nginx_oauth2_buffers | default('8 16k') }};
    proxy_busy_buffers_size {{ enhanced_proxy_nginx_oauth2_busy_buffers_size | default('32k') }};
}

# Enhanced userinfo endpoint for ID token extraction
location = /oauth2/userinfo {
    proxy_pass http://{{ enhanced_proxy_nginx_oauth2_proxy_host }}:{{ enhanced_proxy_nginx_oauth2_proxy_port }};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    
    # Add CORS headers for JavaScript access
    add_header Access-Control-Allow-Origin $scheme://$host;
    add_header Access-Control-Allow-Credentials true;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
    add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With";
    
    # Handle preflight requests
    if ($request_method = OPTIONS) {
        add_header Access-Control-Allow-Origin $scheme://$host;
        add_header Access-Control-Allow-Credentials true;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With";
        add_header Access-Control-Max-Age 1728000;
        add_header Content-Type text/plain;
        add_header Content-Length 0;
        return 204;
    }
    # Header buffers: oauth2-proxy's Set-Cookie on /oauth2/callback carries the
    # session (ID token) and can exceed nginx's default header buffer, which
    # surfaces as "upstream sent too big header" -> 502. Applies even with
    # proxy_buffering off, which only affects the body.
    proxy_buffer_size {{ enhanced_proxy_nginx_oauth2_buffer_size | default('16k') }};
    proxy_buffers {{ enhanced_proxy_nginx_oauth2_buffers | default('8 16k') }};
    proxy_busy_buffers_size {{ enhanced_proxy_nginx_oauth2_busy_buffers_size | default('32k') }};
}
