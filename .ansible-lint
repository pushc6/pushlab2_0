---
# Production-profile lint gate. Waves 1–4 of the cleanup retired most
# of the original skip_list. The remaining entries are the dedicated
# naming-sweep group — defer until a future "Wave 5: name everything"
# pass adds `name:` to the ~1,000 unnamed tasks.
profile: production

exclude_paths:
  - .cache/
  - .git/
  - collections/
  - ansible/group_vars/vault.yml.example
  - ansible/inventories/prod/host_vars/gitea/vault.yml.example
  # Survey-driven playbook — Semaphore supplies target_host at run time.
  # This exclusion is permanent; do not attempt to default target_host
  # (would risk accidental "all hosts" runs).
  - ansible/add_ansible_user_prompt_debian.yml

skip_list:
  # Naming-sweep group — ~1,000 tasks need `name:` and a few plays
  # need their casing fixed. Trimming this list is the next wave.
  - var-naming[no-role-prefix]
  - name[casing]
  - name[missing]
  - name[play]
  - name[template]
